<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>青空サーチ</title>
<link
    href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css"
    rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/papaparse@5.5.3/papaparse.min.js"></script>
<style>
#bodySearchStatus {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-height: 1.5em;
    margin-top: 0.5em;
}
#bodySearchSpinner {
    display: inline-block;
    width: 1em;
    height: 1em;
    border: 3px solid #ddd;
    border-top-color: #555;
    border-radius: 50%;
    animation: bodySearchSpin 0.8s linear infinite;
}
#bodySearchSpinner[hidden] {
    display: none;
}
.body-search-match {
    font-weight: bold;
    background-color: yellow;
}
#aozora-table .tabulator-row.tabulator-selectable:not(.tabulator-selected):hover {
    background-color: #fff;
}
#aozora-table .tabulator-row.tabulator-row-even.tabulator-selectable:not(.tabulator-selected):hover {
    background-color: #efefef;
}
#aozora-table .tabulator-row.tabulator-selected:hover {
    background-color: #9abcea;
}
@keyframes bodySearchSpin {
    to { transform: rotate(360deg); }
}
</style>
</head>
<body>
<h1>青空サーチ</h1>
<button id="download-selected">選択した作品をダウンロード</button>
<br><br>
<!-- =========================================
     読了時間フィルター
     ========================================= -->
<label>
    読了時間：
    <input type="number" id="readingTimeMin" min="0" placeholder="下限" style="width:70px;">
    分 ～
    <input type="number" id="readingTimeMax" min="0" placeholder="上限" style="width:70px;">
    分
<button id="readingTimeSearch">絞り込む</button>
<button id="readingTimeClear">解除</button>
</label>
<br>
<!-- =========================================
     本文検索
     ========================================= -->
<div id="body-search" style="margin: 15px 0;">
    <label for="bodyKeyword">本文検索：</label>
    <input
        type="text"
        id="bodyKeyword"
        placeholder="検索語を入力"
        style="width: 300px; max-width: 60%;"
    >
    <label>
        <input type="checkbox" id="bodyRegexp">
        正規表現
    </label>
    <button type="button" id="bodySearch">検索</button>
    <div id="bodySearchStatus" role="status" aria-live="polite">
        <span id="bodySearchSpinner" aria-hidden="true" hidden></span>
        <span id="bodySearchMessage"></span>
    </div>
    <br>
</div>
<div id="bodySearchResults"></div>
<div id="tableTopScrollbar" aria-label="表の横スクロール" style="overflow-x: auto; overflow-y: hidden; height: 18px;">
    <div id="tableTopScrollbarSpacer" style="height: 1px;"></div>
</div>
<div id="aozora-table"></div>
<script>
let table;
let bodySearchResultTextUrls = null;
const tableTopScrollbar = document.getElementById("tableTopScrollbar");
const tableTopScrollbarSpacer = document.getElementById("tableTopScrollbarSpacer");
let tableBottomScrollbarHolder = null;

function updateTableTopScrollbar() {
    const tableHolder = document.querySelector("#aozora-table .tabulator-tableholder");
    if (!tableHolder) return;
    if (tableBottomScrollbarHolder !== tableHolder) {
        tableBottomScrollbarHolder = tableHolder;
        tableHolder.addEventListener("scroll", function() {
            if (tableTopScrollbar.scrollLeft !== tableHolder.scrollLeft) {
                tableTopScrollbar.scrollLeft = tableHolder.scrollLeft;
            }
        });
    }
    const tableContent = tableHolder.querySelector(".tabulator-table");
    const contentWidth = Math.max(
        tableHolder.scrollWidth,
        tableContent ? tableContent.scrollWidth : 0
    );
    tableTopScrollbarSpacer.style.width = contentWidth + "px";
    tableTopScrollbar.scrollLeft = tableHolder.scrollLeft;
}

tableTopScrollbar.addEventListener("scroll", function() {
    const tableHolder = document.querySelector("#aozora-table .tabulator-tableholder");
    if (tableHolder && tableHolder.scrollLeft !== tableTopScrollbar.scrollLeft) {
        tableHolder.scrollLeft = tableTopScrollbar.scrollLeft;
    }
});

function bodySearchResultFilter(row) {
    return bodySearchResultTextUrls === null ||
        bodySearchResultTextUrls.has(row.text_url);
}

console.time("ページ表示");
console.time("CSV読み込み");
// =========================================
// 読了時間「00h30min」を「30分」に変換
// =========================================
function toMinutes(value) {
    const match = value.match(/(\d+)h(\d+)min/);
    if (!match) return 0;
    const hours = parseInt(match[1], 10);
    const minutes = parseInt(match[2], 10);
    return hours * 60 + minutes;
}
Papa.parse("ao_search.csv", {
    download: true,
    header: true,
    encoding: "UTF-8",
    complete: function(results) {
        console.timeEnd("CSV読み込み");
        console.time("Tabulator生成");
        console.log("読み込み件数:", results.data.length);
        // idのない行（CSV末尾の空行など）を除外
        const data = results.data
            .filter(row => row.id)
            .map(row => ({
                ...row,
                reading_time_minutes: toMinutes(row.reading_time)
            }));
        // 作品の表示順をランダムにする
        data.sort(() => Math.random() - 0.5);
        console.log(data[0]);
        table = new Tabulator("#aozora-table", {
            data: data,
            layout: "fitData",
            autoResize: false,
            pagination: true,
            paginationSize: 30,
            paginationSizeSelector: [10, 30, 50, 100],
            movableColumns: true,
            selectableRows: "highlight",
            columns: [
                // 個別選択用チェックボックス
                {
                    formatter: "rowSelection",
                    titleFormatter: "rowSelection",
                    titleFormatterParams: {
                        rowRange: "active"
                    },
                    hozAlign: "center",
                    headerSort: false,
                    cellClick: function(e, cell) {
                        cell.getRow().toggleSelect();
                    }
                },
                {
                    title: "題名",
                    field: "title",
                    headerFilter: "input",
                    width: 250
                },
                {
                    title: "作者",
                    field: "author",
                    headerFilter: "input"
                },
                {
                    title: "入力",
                    field: "inputter",
                    headerFilter: "input"
                },
                {
                    title: "校正",
                    field: "proofreader",
                    headerFilter: "input"
                },
                {
                    title: "形式",
                    field: "text_type",
                    headerFilter: "input"
                },
                {
                    title: "読了時間",
                    field: "reading_time",
                    // 表示は「00h30min」のまま
                    // ソートだけ「分」に換算して行う
                    sorter: function(a, b) {
                        return toMinutes(a) - toMinutes(b);
                    }
                },
                // 内部計算用。画面には表示しない
                {
                    title: "読了時間（分）",
                    field: "reading_time_minutes",
                    visible: false
                },
                {
                    title: "リンク",
                    formatter: function(cell) {
                        const row = cell.getRow().getData();
                        const match = row.card_url.match(/card(\d+)/);
                        const binb_url = match
                            ? `https://aozora.binb.jp/reader/main.html?cid=${match[1]}`
                            : '#';
                        return `
                            <a href="text_view.html?file=${encodeURIComponent(row.text_url)}" target="_blank">[text]</a>
                            <a href="${row.html_url}" target="_blank">[html]</a>
                            <a href="${row.card_url}" target="_blank">[card]</a>
                            <a href="${binb_url}" target="_blank">[binb]</a>
                            <a href="text.html?file=${encodeURIComponent(row.text_url)}" target="_blank">[edit]</a>
                        `;
                    }
                }
            ],
            // 表の描画が完了したら計測終了
            renderComplete: function() {
                console.timeEnd("ページ表示");
                updateTableTopScrollbar();
            }
        });
        table.addFilter(bodySearchResultFilter);
        updateTableTopScrollbar();
        if (window.ResizeObserver) {
            const tableResizeObserver = new ResizeObserver(updateTableTopScrollbar);
            tableResizeObserver.observe(document.getElementById("aozora-table"));
        }
        window.addEventListener("resize", updateTableTopScrollbar);
        console.timeEnd("Tabulator生成");
        // =========================================
        // 読了時間で絞り込む
        // =========================================
        document
            .getElementById("readingTimeSearch")
            .addEventListener("click", function() {
                const minValue =
                    document.getElementById("readingTimeMin").value;
                const maxValue =
                    document.getElementById("readingTimeMax").value;
                // まず読了時間フィルターを解除
                table.removeFilter("reading_time_minutes");
                // 下限が入力されていれば「○分以上」
                if (minValue !== "") {
                    table.addFilter(
                        "reading_time_minutes",
                        ">=",
                        Number(minValue)
                    );
                }
                // 上限が入力されていれば「○分以内」
                if (maxValue !== "") {
                    table.addFilter(
                        "reading_time_minutes",
                        "<=",
                        Number(maxValue)
                    );
                }
            });
        // =========================================
        // 読了時間フィルターを解除
        // =========================================
        document
            .getElementById("readingTimeClear")
            .addEventListener("click", function() {
                document.getElementById("readingTimeMin").value = "";
                document.getElementById("readingTimeMax").value = "";
                table.removeFilter("reading_time_minutes");
            });
    }
});
// =========================================
// 選択した作品をダウンロード
// =========================================
document
    .getElementById("download-selected")
    .addEventListener("click", function() {
        const rows = getActiveSelectedRows();
        if (rows.length === 0) {
            alert("ダウンロードする作品を選択してください。");
            return;
        }
        const form = document.createElement("form");
        form.method = "POST";
        form.action = "download.php";
        rows.forEach(row => {
            const data = row.getData();
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "text_urls[]";
            input.value = data.text_url;
            form.appendChild(input);
        });
        document.body.appendChild(form);
        form.submit();
        form.remove();
    });
// =========================================
// 本文検索
// =========================================
let activeBodySearchJobId = null;
let bodySearchCancelPending = false;
let bodySearchStopRequested = false;
let bodySearchInProgress = false;
const bodySearchButton = document.getElementById("bodySearch");
const bodySearchSpinner = document.getElementById("bodySearchSpinner");
const bodySearchMessage = document.getElementById("bodySearchMessage");

function showBodySearchMatchesInTable(textUrls) {
    if (textUrls.size === 0) {
        return;
    }
    bodySearchResultTextUrls = textUrls;
    table.refreshFilter();
}

function getActiveSelectedRows() {
    const activeIds = new Set(
        table.getData("active").map(row => row.id)
    );
    return table.getSelectedRows().filter(row =>
        activeIds.has(row.getData().id)
    );
}

function createBodySearchJobId() {
    const bytes = new Uint8Array(16);
    window.crypto.getRandomValues(bytes);
    return Array.from(bytes, byte => byte.toString(16).padStart(2, "0")).join("");
}

async function postBodySearchRequest(payload) {
    const response = await fetch("search_selected.cgi", {
        method: "POST",
        headers: {
            "Content-Type": "application/json; charset=UTF-8"
        },
        body: JSON.stringify(payload)
    });
    const data = await response.json();
    if (!response.ok || !data.ok) {
        throw new Error(data.error || "検索に失敗しました。");
    }
    return data;
}

async function streamBodySearchRequest(payload, onResult) {
    const response = await fetch("search_selected.cgi", {
        method: "POST",
        headers: {
            "Content-Type": "application/json; charset=UTF-8"
        },
        body: JSON.stringify(payload)
    });
    if (!response.ok) {
        throw new Error("検索に失敗しました。HTTP " + response.status);
    }
    if (!response.body) {
        throw new Error("このブラウザーは検索結果の逐次受信に対応していません。");
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let pending = "";
    let terminal = null;

    function processLine(line) {
        if (!line.trim()) {
            return;
        }
        const event = JSON.parse(line);
        if (event.type === "result") {
            onResult(event.work);
        } else if (event.type === "complete") {
            terminal = { cancelled: false, count: event.count };
        } else if (event.type === "cancelled") {
            terminal = { cancelled: true };
        } else if (event.type === "error") {
            throw new Error(event.error || "検索中にエラーが発生しました。");
        } else {
            throw new Error("検索結果の形式が正しくありません。");
        }
    }

    while (!terminal) {
        const chunk = await reader.read();
        pending += decoder.decode(
            chunk.value || new Uint8Array(),
            { stream: !chunk.done }
        );
        const lines = pending.split("\n");
        pending = lines.pop();
        for (const line of lines) {
            processLine(line);
            if (terminal) {
                break;
            }
        }
        if (chunk.done) {
            break;
        }
    }
    if (!terminal && pending.trim()) {
        processLine(pending);
    }
    if (!terminal) {
        throw new Error("検索結果の受信が途中で終了しました。");
    }
    return terminal;
}

function appendBodySearchSnippet(element, text, pattern) {
    pattern.lastIndex = 0;
    let lastIndex = 0;
    let match;
    while ((match = pattern.exec(text)) !== null) {
        if (match[0].length === 0) {
            // 空文字に一致する正規表現でも無限ループしないようにする
            pattern.lastIndex = match.index + 1;
            continue;
        }
        if (match.index > lastIndex) {
            element.appendChild(
                document.createTextNode(text.slice(lastIndex, match.index))
            );
        }
        const highlighted = document.createElement("span");
        highlighted.className = "body-search-match";
        highlighted.textContent = match[0];
        element.appendChild(highlighted);
        lastIndex = match.index + match[0].length;
    }
    if (lastIndex < text.length) {
        element.appendChild(document.createTextNode(text.slice(lastIndex)));
    }
}

function appendBodySearchWork(results, work, highlightPattern) {
    const section = document.createElement("div");
    section.style.margin = "1em 0";
    section.style.padding = "0.5em";
    section.style.borderBottom = "1px solid #ccc";
    const title = document.createElement("strong");
    title.textContent = work.title;
    section.appendChild(title);
    const author = document.createElement("span");
    author.textContent = "（" + work.author + "）";
    section.appendChild(author);
    const count = document.createElement("p");
    count.textContent = "該当行数：" + work.hit_count;
    section.appendChild(count);
    // 本文・HTML・カードへのリンク
    const links = document.createElement("p");
    const textLink = document.createElement("a");
    textLink.href =
        "text_view.html?file=" +
        encodeURIComponent(work.text_url);
    textLink.target = "_blank";
    textLink.textContent = "[text]";
    links.appendChild(textLink);
    links.appendChild(document.createTextNode(" "));
    const htmlLink = document.createElement("a");
    htmlLink.href = work.html_url;
    htmlLink.target = "_blank";
    htmlLink.textContent = "[html]";
    links.appendChild(htmlLink);
    links.appendChild(document.createTextNode(" "));
    const cardLink = document.createElement("a");
    cardLink.href = work.card_url;
    cardLink.target = "_blank";
    cardLink.textContent = "[card]";
    links.appendChild(cardLink);
    section.appendChild(links);
    // 該当箇所の抜粋
    work.snippets.forEach(snippet => {
        const excerpt = document.createElement("p");
        appendBodySearchSnippet(excerpt, snippet, highlightPattern);
        excerpt.style.marginLeft = "1em";
        section.appendChild(excerpt);
    });
    results.appendChild(section);
}

bodySearchButton.addEventListener("click", async function() {
    if (bodySearchInProgress) {
        if (bodySearchCancelPending) {
            return;
        }
        const jobId = activeBodySearchJobId;
        bodySearchStopRequested = true;
        bodySearchCancelPending = true;
        bodySearchButton.disabled = true;
        bodySearchMessage.textContent = "検索を中断しています…";
        if (!jobId) {
            // 次の検索IDを準備中。IDの準備ができた後で中断処理を行う
            return;
        }
        try {
            const cancelResult = await postBodySearchRequest({
                action: "cancel",
                job_id: jobId
            });
            if (!cancelResult.accepted && activeBodySearchJobId === jobId) {
                bodySearchCancelPending = false;
                bodySearchButton.disabled = false;
                bodySearchButton.textContent = "中断";
                bodySearchMessage.textContent =
                    "中断要求が届きませんでした。もう一度お試しください。";
            }
        } catch (error) {
            if (activeBodySearchJobId === jobId) {
                bodySearchCancelPending = false;
                bodySearchButton.disabled = false;
                bodySearchButton.textContent = "中断";
                bodySearchMessage.textContent =
                    "中断要求を送信できませんでした。もう一度お試しください。";
                console.error(error);
            }
        }
        return;
    }

    const keyword =
        document.getElementById("bodyKeyword").value.trim();
    const regexp =
        document.getElementById("bodyRegexp").checked;
    const results =
        document.getElementById("bodySearchResults");
    if (!table) {
        alert("作品一覧の読み込みが完了していません。");
        return;
    }
    if (keyword === "") {
        alert("検索する文字列を入力してください。");
        return;
    }
    // 正規表現の構文を確認
    if (regexp) {
        try {
            new RegExp(keyword);
        } catch (e) {
            alert("正規表現が正しくありません。\n" + e.message);
            return;
        }
    }
    const highlightPattern = new RegExp(
        regexp
            ? keyword
            : keyword.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
        "g"
    );
    // チェックがあれば絞り込み中のチェック済み作品、なければ全作品を検索
    const selectedWorks = getActiveSelectedRows().map(row => row.getData());
    const works = selectedWorks.length > 0
        ? selectedWorks
        : table.getData();
    const targets = works
        .filter(row => row.text_url)
        .map(row => ({
            text_url: row.text_url,
            title: row.title,
            author: row.author,
            card_url: row.card_url,
            html_url: row.html_url
        }));
    if (targets.length === 0) {
        bodySearchMessage.textContent = "検索対象の作品がありません。";
        return;
    }

    activeBodySearchJobId = null;
    bodySearchCancelPending = false;
    bodySearchStopRequested = false;
    bodySearchInProgress = true;
    bodySearchButton.disabled = false;
    bodySearchButton.textContent = "中断";
    bodySearchSpinner.hidden = false;
    const groupCount = Math.min(20, targets.length);
    let outputStarted = false;
    let displayedWorkCount = 0;
    let summary = null;
    let pendingGroupResults = [];
    const matchedTextUrls = new Set();

    function appendGroupResults(groupResults) {
        if (groupResults.length === 0) {
            return;
        }
        if (!outputStarted) {
            results.replaceChildren();
            summary = document.createElement("p");
            results.appendChild(summary);
            outputStarted = true;
        }
        for (const work of groupResults) {
            displayedWorkCount += 1;
            if (work.text_url) {
                matchedTextUrls.add(work.text_url);
            }
            appendBodySearchWork(results, work, highlightPattern);
        }
        summary.textContent =
            "検索対象 " + targets.length + "作品：" +
            displayedWorkCount + "作品で該当しました（検索中…）。";
    }

    try {
        bodySearchMessage.textContent =
            targets.length + "作品を" + groupCount + "グループに分けて検索します。";
        let cancelled = false;
        for (let groupIndex = 0; groupIndex < groupCount; groupIndex++) {
            if (bodySearchStopRequested) {
                cancelled = true;
                break;
            }

            const groupJobId = createBodySearchJobId();
            const start = Math.floor(groupIndex * targets.length / groupCount);
            const end = Math.floor((groupIndex + 1) * targets.length / groupCount);
            const groupWorks = targets.slice(start, end);
            pendingGroupResults = [];
            activeBodySearchJobId = null;
            bodySearchMessage.textContent =
                "検索中… " + (groupIndex + 1) + " / " + groupCount + " グループ";

            await postBodySearchRequest({
                action: "start",
                job_id: groupJobId
            });
            if (bodySearchStopRequested) {
                // 中断要求が準備中に押されていた場合は、このグループを開始しない
                await postBodySearchRequest({
                    action: "cancel",
                    job_id: groupJobId
                });
                await streamBodySearchRequest({
                    action: "search",
                    job_id: groupJobId,
                    keyword: keyword,
                    regexp: regexp,
                    works: []
                }, function() {});
                cancelled = true;
                break;
            }

            activeBodySearchJobId = groupJobId;
            const data = await streamBodySearchRequest({
                action: "search",
                job_id: groupJobId,
                keyword: keyword,
                regexp: regexp,
                works: groupWorks
            }, function(work) {
                pendingGroupResults.push(work);
            });
            appendGroupResults(pendingGroupResults);
            pendingGroupResults = [];
            activeBodySearchJobId = null;

            if (data.cancelled || bodySearchStopRequested) {
                cancelled = true;
                break;
            }
        }

        if (cancelled) {
            showBodySearchMatchesInTable(matchedTextUrls);
            table.deselectRow();
            if (summary) {
                summary.textContent =
                    "検索対象 " + targets.length + "作品：中断時点で" +
                    displayedWorkCount + "作品に該当しました。";
            }
            bodySearchMessage.textContent = "検索を中断しました。";
            return;
        }
        if (!outputStarted) {
            results.replaceChildren();
            summary = document.createElement("p");
            results.appendChild(summary);
        }
        summary.textContent =
            "検索対象 " + targets.length + "作品：" +
            displayedWorkCount + "作品で該当しました。";
        if (displayedWorkCount === 0) {
            const message = document.createElement("p");
            message.textContent = "該当する作品はありませんでした。";
            results.appendChild(message);
            table.deselectRow();
            bodySearchMessage.textContent = "";
            return;
        }
        showBodySearchMatchesInTable(matchedTextUrls);
        table.deselectRow();
        bodySearchMessage.textContent = "";
    } catch (error) {
        appendGroupResults(pendingGroupResults);
        pendingGroupResults = [];
        showBodySearchMatchesInTable(matchedTextUrls);
        table.deselectRow();
        // 通信エラーなどで画面側が先に終了しても、サーバーへ中断を依頼
        const jobId = activeBodySearchJobId;
        if (jobId) {
            try {
                await postBodySearchRequest({
                    action: "cancel",
                    job_id: jobId
                });
            } catch (_) {
                // 元の検索エラーを表示する
            }
        }
        if (summary) {
            summary.textContent =
                "検索対象 " + targets.length + "作品：エラー発生までに" +
                displayedWorkCount + "作品の結果を表示しました。";
        }
        bodySearchMessage.textContent = "検索エラー：" + error.message;
    } finally {
        activeBodySearchJobId = null;
        bodySearchCancelPending = false;
        bodySearchStopRequested = false;
        bodySearchInProgress = false;
        bodySearchSpinner.hidden = true;
        bodySearchButton.disabled = false;
        bodySearchButton.textContent = "検索";
    }
});
</script>
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">ご利用にあたって</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>・この表は、<a href="https://www.aozora.gr.jp/index_pages/person_all.html">青空文庫</a>の「公開中の作家別作品一覧拡充版：全て（CSV形式、UTF-8、zip圧縮）」をもとに作成しています。</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>・「text」リンクおよび「選択した作品をダウンロード」で提供するテキストは、青空文庫のテキストデータをSJIS（Shift_JIS）からUTF-8に変換しています。</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>・元データにUnicode特有の文字が注釈として埋め込まれている場合は、可能なものについて注釈から文字を取り出し、テキストに反映しています。</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>・上記の加工を行っているため、本サイトで提供するテキストは青空文庫の元データと完全に同一ではありません。</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>・青空文庫の作品には、著作権が消滅した作品のほか、「クリエイティブ・コモンズ 表示 4.0 国際（CC BY 4.0）」のライセンスで提供されている作品があります。後者については、各作品のライセンス条件に従ってご利用ください。</p>
